---
import { Image, getImage } from "astro:assets";
import Icon from "./Icon.astro";
import { gallery } from "../data/site";

const items = await Promise.all(
  gallery.map(async (item) => ({
    ...item,
    full: await getImage({ src: item.image, width: 1600, format: "webp" }),
  })),
);
---

<section id="gallery" class="section section-tinted">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">Gallery</p>
      <h2>Made by our members</h2>
      <p>
        A glimpse of the work, and the people, that fill our studio every week.
      </p>
    </div>
    <ul class="gallery-grid">
      {
        items.map((item) => (
          <li class:list={["gallery-item", item.layout]}>
            <a href={item.full.src} data-alt={item.alt}>
              <Image
                src={item.image}
                alt={item.alt}
                widths={[400, 800]}
                sizes="(max-width: 48rem) 50vw, 25vw"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <dialog class="lightbox" aria-label="Image viewer">
    <button class="lightbox-close" type="button" aria-label="Close">
      <Icon name="close" size={28} />
    </button>
    <button class="lightbox-nav prev" type="button" aria-label="Previous image">
      <Icon name="chevronLeft" size={32} />
    </button>
    <figure>
      <img alt="" />
      <figcaption></figcaption>
    </figure>
    <button class="lightbox-nav next" type="button" aria-label="Next image">
      <Icon name="chevronRight" size={32} />
    </button>
  </dialog>
</section>

<script>
  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>(".gallery-item a"),
  ];
  const dialog = document.querySelector<HTMLDialogElement>(".lightbox")!;
  const img = dialog.querySelector("img")!;
  const caption = dialog.querySelector("figcaption")!;
  let current = 0;

  const show = (index: number) => {
    current = (index + links.length) % links.length;
    const link = links[current];
    img.src = link.href;
    img.alt = link.dataset.alt ?? "";
    caption.textContent = `${link.dataset.alt} (${current + 1} of ${links.length})`;
  };

  links.forEach((link, i) =>
    link.addEventListener("click", (e) => {
      e.preventDefault();
      show(i);
      dialog.showModal();
    }),
  );

  dialog
    .querySelector(".prev")!
    .addEventListener("click", () => show(current - 1));
  dialog
    .querySelector(".next")!
    .addEventListener("click", () => show(current + 1));
  dialog
    .querySelector(".lightbox-close")!
    .addEventListener("click", () => dialog.close());
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft") show(current - 1);
    if (e.key === "ArrowRight") show(current + 1);
  });
  dialog.addEventListener("close", () => links[current].focus());
</script>
