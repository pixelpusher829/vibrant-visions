---
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";

export const getStaticPaths = (async () => {
  const tutorials = (await getCollection("tutorials")).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return tutorials.map((tutorial, i) => ({
    params: { slug: tutorial.id },
    props: { tutorial, next: tutorials[(i + 1) % tutorials.length] },
  }));
}) satisfies GetStaticPaths;

const { tutorial, next } = Astro.props;
const { Content } = await render(tutorial);
const home = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Layout
  title={tutorial.data.title}
  description={tutorial.data.description}
  ogImage={tutorial.data.image}
  type="article"
>
  <article class="article">
    <header class="article-header">
      <div class="container article-container">
        <a class="text-link back-link" href={`${home}#tutorials`}>
          <Icon name="arrowLeft" size={16} /> All tutorials
        </a>
        <p class="tutorial-meta">
          <span class="badge">{tutorial.data.level}</span>
          <span><Icon name="book" size={16} /> {tutorial.data.duration}</span>
        </p>
        <h1>{tutorial.data.title}</h1>
        <p class="article-lead">{tutorial.data.description}</p>
      </div>
    </header>
    <div class="container article-container">
      <Image
        class="article-image"
        src={tutorial.data.image}
        alt={tutorial.data.alt}
        widths={[600, 900, 1400]}
        sizes="(max-width: 52rem) 100vw, 52rem"
        loading="eager"
      />
      {
        tutorial.data.materials.length > 0 && (
          <aside class="materials">
            <h2>What you'll need</h2>
            <ul>
              {tutorial.data.materials.map((m) => (
                <li>
                  <Icon name="check" size={18} />
                  {m}
                </li>
              ))}
            </ul>
          </aside>
        )
      }
      <div class="prose">
        <Content />
      </div>

      <aside class="article-cta">
        <h2>Want to try this with a teacher?</h2>
        <p>
          Our workshops cover these techniques in person, with materials
          provided and friendly guidance from working artists.
        </p>
        <div class="hero-actions">
          <a class="btn btn-accent" href={`${home}#events`}
            >See upcoming workshops</a
          >
          <a class="btn btn-outline" href={`${home}#membership`}
            >Explore membership</a
          >
        </div>
      </aside>

      {
        next.id !== tutorial.id && (
          <nav class="next-tutorial" aria-label="Next tutorial">
            <span>Next tutorial</span>
            <a href={`${home}tutorials/${next.id}/`}>
              {next.data.title} <Icon name="arrowRight" size={18} />
            </a>
          </nav>
        )
      }
    </div>
  </article>
</Layout>
